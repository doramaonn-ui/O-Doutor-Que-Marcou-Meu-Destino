<script>
  // Cronômetro regressivo de urgência (10 min, reinicia)
  function iniciarCronometro(){
    var duracao = 10*60;
    var el = document.getElementById('cronometro');
    var restante = duracao;
    function atualizar(){
      var m = Math.floor(restante/60);
      var s = restante%60;
      el.textContent = (m<10?'0':'')+m+':'+(s<10?'0':'')+s;
      if(restante<=0){ restante = duracao; } else { restante--; }
    }
    atualizar();
    setInterval(atualizar, 1000);
  }
  iniciarCronometro();

  // Popup fixo após rolagem
  var popup = document.getElementById('popupFixo');
  var mostrado = false;
  window.addEventListener('scroll', function(){
    if(window.scrollY > 400 && !mostrado){
      popup.classList.add('visivel');
    }
  });
  document.getElementById('fecharPopup').addEventListener('click', function(){
    popup.classList.remove('visivel');
    mostrado = true;
  });

  // Rastreamento de clique no botão principal
  document.getElementById('btnComprarPrincipal').addEventListener('click', function(){
    if(typeof fbq !== 'undefined'){ fbq('track', 'InitiateCheckout'); }
  });
</script>

